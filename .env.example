# SpendSense AI Configuration

# 1. Custom Agent API Configuration
# Replace with your Agent's URL (e.g. IBM watsonx Orchestrate endpoint, Custom API, etc.)
AGENT_API_URL=https://your-custom-agent-endpoint.com

# Replace with your Authorization API Key / Bearer token (leave empty if not needed)
AGENT_API_KEY=your_secure_api_key_here

# Replace with your Agent ID
AGENT_ID=your_agent_id_here

# Replace with your Neon Postgres Database URL
DATABASE_URL=postgresql://neondb_owner:password@endpoint.neon.tech/neondb?sslmode=require

# IBM IAM API Details (Optional reference values from Watson JSON)
IAM_APIKEY_DESCRIPTION=your_iam_apikey_description
IAM_APIKEY_ID=your_iam_apikey_id
IAM_APIKEY_NAME=your_iam_apikey_name
IAM_SERVICEID_CRN=your_iam_serviceid_crn
